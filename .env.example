# TalkBuddy Configuration
# Copy this to .env and adjust values

# === Server ===
SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__LOG_LEVEL=INFO

# === LLM (llama-cpp-python, Vulkan) ===
LLM__MODEL_PATH=models/llm/model.gguf
LLM__N_GPU_LAYERS=-1
LLM__N_CTX=4096
LLM__N_THREADS=8
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=256

# === STT (faster-whisper) ===
STT__MODEL_SIZE=large-v3-turbo
STT__DEVICE=cpu
STT__COMPUTE_TYPE=int8
STT__LANGUAGE=en

# === TTS (Kokoro-82M) ===
TTS__VOICE=af_heart
TTS__SPEED=1.0
TTS__LANG_CODE=a

# === VAD (Silero VAD) ===
VAD__THRESHOLD=0.5
VAD__MIN_SILENCE_DURATION_MS=350
VAD__MIN_SPEECH_DURATION_MS=96

# === Audio ===
AUDIO__INPUT_SAMPLE_RATE=16000
AUDIO__OUTPUT_SAMPLE_RATE=24000
